# ===========================================================================
# rag-core .env.example -- Phase 1 (RCSI-P1) Config/Env Separation
# ===========================================================================
# Copy this file to .env and fill in real values for local development.
# DO NOT commit .env or any file containing real credentials.
#
# Ownership boundaries (Phase 1 establishes these; later phases enforce them):
#   rag-core owns: rag_core Postgres DB, rag-source-files MinIO bucket,
#                  Redis DB 2/3, rag.* Celery queues.
#   DominicBE owns: chatbot_db, dominic-knowledge bucket, Redis DB 0/1,
#                   chatbot.* queues.
#   DominicBE calls rag-core via HTTP API only -- no direct DB/queue access.
# ===========================================================================


# ---------------------------------------------------------------------------
# rag-core API service identity
# ---------------------------------------------------------------------------
RAG_CORE_APP_NAME=rag-core
RAG_CORE_HOST=0.0.0.0
RAG_CORE_PORT=8010

# Bearer token for rag-core API auth. Set to a random secret; never commit a real value.
RAG_CORE_API_KEY=replace-with-a-random-secret


# ---------------------------------------------------------------------------
# RCSI-P1-T01: PostgreSQL database (rag-core owns the 'rag_core' database)
# ---------------------------------------------------------------------------
# rag-core connects to the 'rag_core' database, NOT to 'chatbot_db'.
# In local/dev both databases share the same Postgres container.
# Set RAG_CORE_DATABASE_URL to override all RAG_CORE_DB_* component vars.
#
# Component var example:
#   RAG_CORE_DB_HOST=127.0.0.1
#   RAG_CORE_DB_PORT=5432
#   RAG_CORE_DB_USER=rag_core
#   RAG_CORE_DB_PASSWORD=your_rag_core_password_here
#   RAG_CORE_DB_NAME=rag_core
#
# Full URL override example:
#   RAG_CORE_DATABASE_URL=postgresql+psycopg://rag_core:your_password@127.0.0.1:5432/rag_core
RAG_CORE_DATABASE_URL=
RAG_CORE_DB_HOST=127.0.0.1
RAG_CORE_DB_PORT=5432
RAG_CORE_DB_USER=rag_core
RAG_CORE_DB_PASSWORD=your_rag_core_password_here
RAG_CORE_DB_NAME=rag_core
RAG_CORE_DB_SSL=false
# Connection pool settings (tune for your workload)
RAG_CORE_DB_POOL_SIZE=5
RAG_CORE_DB_MAX_OVERFLOW=10
RAG_CORE_DB_POOL_RECYCLE=300
RAG_CORE_DB_POOL_TIMEOUT=10
RAG_CORE_DB_CONNECT_TIMEOUT=10


# ---------------------------------------------------------------------------
# RCSI-P1-T02: Redis / Celery worker (rag-core owns Redis DB 2/3)
# ---------------------------------------------------------------------------
# rag-core uses Redis DB 2 for the broker and DB 3 for results.
# DominicBE uses DB 0/1. Do NOT change these indices to overlap.
# RAG_CORE_CELERY_ENABLED=false by default -- API starts without a worker.
# Set to true when running the rag-core-worker Docker service.
RAG_CORE_CELERY_ENABLED=false
RAG_CORE_CELERY_BROKER_URL=redis://127.0.0.1:6379/2
RAG_CORE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
# Celery app and worker settings
RAG_CORE_CELERY_APP_NAME=rag_core
RAG_CORE_CELERY_DEFAULT_QUEUE=rag.ingestion
RAG_CORE_CELERY_TASK_SERIALIZER=json
RAG_CORE_CELERY_RESULT_SERIALIZER=json
RAG_CORE_CELERY_WORKER_CONCURRENCY=2
RAG_CORE_CELERY_TASK_TIME_LIMIT=3600
RAG_CORE_CELERY_TASK_SOFT_TIME_LIMIT=3300
RAG_CORE_CELERY_MAX_TASKS_PER_CHILD=100
# Task queue names (rag.* namespace is owned exclusively by rag-core)
RAG_CORE_QUEUE_INGESTION=rag.ingestion
RAG_CORE_QUEUE_EMBEDDING=rag.embedding
RAG_CORE_QUEUE_REINDEX=rag.reindex
RAG_CORE_QUEUE_CLEANUP=rag.cleanup
RAG_CORE_QUEUE_EVAL=rag.eval
# Redis auth example (if your Redis requires a password):
#   RAG_CORE_CELERY_BROKER_URL=redis://:your_redis_password@127.0.0.1:6379/2
#   RAG_CORE_CELERY_RESULT_BACKEND=redis://:your_redis_password@127.0.0.1:6379/3


# ---------------------------------------------------------------------------
# RCSI-P1-T03: Object storage (rag-core owns the 'rag-source-files' bucket)
# ---------------------------------------------------------------------------
# rag-core stores ingested source files in its own bucket/prefix.
# DominicBE owns the 'dominic-knowledge' bucket -- do NOT mix them.
# Phase 4 intake contract: callers send multipart file bytes to rag-core.
# URI/reference intake is disabled by default to avoid cross-bucket ownership leaks.
#
# Provider options: local | minio | s3
#   local:  files saved to RAG_CORE_OBJECT_STORAGE_LOCAL_PATH on disk.
#   minio:  point RAG_CORE_OBJECT_STORAGE_ENDPOINT at your MinIO server.
#   s3:     standard AWS S3; set region and leave endpoint empty.
RAG_CORE_OBJECT_STORAGE_PROVIDER=local
RAG_CORE_OBJECT_STORAGE_BUCKET=rag-source-files
RAG_CORE_OBJECT_STORAGE_ENDPOINT=
RAG_CORE_OBJECT_STORAGE_ACCESS_KEY=
RAG_CORE_OBJECT_STORAGE_SECRET_KEY=
RAG_CORE_OBJECT_STORAGE_REGION=
RAG_CORE_OBJECT_STORAGE_SECURE=true
RAG_CORE_OBJECT_STORAGE_LOCAL_PATH=.rag-storage
# Optional key prefix (e.g. 'rag/' when sharing a bucket with a dedicated prefix)
RAG_CORE_OBJECT_STORAGE_KEY_PREFIX=
# Maximum multipart upload size accepted by POST /rag/v1/documents (25 MiB default)
RAG_CORE_OBJECT_STORAGE_MAX_UPLOAD_BYTES=26214400
# MinIO example (docker-compose.local-rag.yml):
#   RAG_CORE_OBJECT_STORAGE_PROVIDER=minio
#   RAG_CORE_OBJECT_STORAGE_BUCKET=rag-source-files
#   RAG_CORE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
#   RAG_CORE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
#   RAG_CORE_OBJECT_STORAGE_SECRET_KEY=your_minio_secret_here
#   RAG_CORE_OBJECT_STORAGE_SECURE=false


# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
# Shared embedding configuration used by both the rag-core API and worker.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=64
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16
# API embedding provider (set these when EMBEDDING_PROVIDER=api)
EMBEDDING_API_KEY=
EMBEDDING_API_TYPE=
EMBEDDING_API_VERSION=
EMBEDDING_API_HEADERS=
# Ollama example:
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=qwen3-embedding:0.6b
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=http://localhost:11434


# ---------------------------------------------------------------------------
# Chunking / ingestion pipeline
# ---------------------------------------------------------------------------
INGESTION_PIPELINE=custom
CHUNK_SIZE=800
CHUNK_OVERLAP=100


# ---------------------------------------------------------------------------
# Vector store (Qdrant is the recommended provider for rag-core)
# ---------------------------------------------------------------------------
# rag-core owns all rag_* Qdrant collections.
# DominicBE must not create, rename, or delete rag_* collections directly.
VECTOR_STORE_PROVIDER=database
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=rag_default_local_local_hash_v1
VECTOR_STORE_TIMEOUT_SECONDS=10
VECTOR_STORE_PREFER_GRPC=false
# Qdrant example:
#   VECTOR_STORE_PROVIDER=qdrant
#   VECTOR_STORE_URL=http://127.0.0.1:6333
#   VECTOR_STORE_COLLECTION=rag_default_local_local_hash_v1


# ---------------------------------------------------------------------------
# Retrieval settings
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_MIN_LEXICAL_SCORE=0.1
RETRIEVAL_HYBRID_SEMANTIC_WEIGHT=0.4
RETRIEVAL_HYBRID_LEXICAL_WEIGHT=0.6
RETRIEVAL_ENABLE_QUERY_EXPANSION=true
RETRIEVAL_MAX_RERANK_CANDIDATES=12
RETRIEVAL_RERANK_TITLE_WEIGHT=0.15
RETRIEVAL_RERANK_POSITION_WEIGHT=0.1
RETRIEVAL_LOW_CONFIDENCE_SCORE=0.2
RETRIEVAL_MAX_CONTEXT_TOKENS=4000
RETRIEVAL_MAX_CONTEXT_CHUNKS=6
